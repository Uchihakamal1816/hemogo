# Firebase web config (Project settings > General). These values are public.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hemogo-emergency.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hemogo-emergency
VITE_FIREBASE_STORAGE_BUCKET=hemogo-emergency.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Project settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Local development against the Firebase emulators
# VITE_USE_EMULATORS=true

# Razorpay keys are server-side only. Set them with:
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
