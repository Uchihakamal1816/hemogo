rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    // Chat and location only open between the two parties after the donor accepts.
    function isPartyToAcceptedMatch(matchId) {
      let m = matchData(matchId);
      return isAuthenticated() && m.response == 'ACCEPTED' &&
        (m.donorId == request.auth.uid || m.requesterId == request.auth.uid);
    }

    // Users: roles and premium can never be self-assigned; admins are promoted in the console.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.phone == request.auth.token.phone_number &&
        request.resource.data.role in ['donor', 'requester', 'both'] &&
        request.resource.data.premiumStatus == false &&
        request.resource.data.status == 'active' &&
        !('premiumExpiry' in request.resource.data);
      allow update: if (isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'pinCode', 'updatedAt'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Donors: zero-scrape. Created by registerDonor; availability changes go through
    // toggleDonorAvailability so the medical cooldown cannot be skipped.
    match /donors/{donorId} {
      allow read: if isOwner(donorId) || isAdmin();
      allow create: if false;
      allow update: if (isOwner(donorId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'alternatePhone', 'city', 'pinCode', 'preferredRadiusKm', 'updatedAt'])) || isAdmin();
      allow delete: if isOwner(donorId) || isAdmin();
    }

    match /deviceTokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Requests carry patient details, so only the requester and admins read them.
    // Donors see a reduced copy on their match. All writes are server-side.
    match /bloodRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Donor name and phone are only written here by the server after acceptance.
    match /matches/{matchId} {
      allow read: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /chats/{matchId}/messages/{messageId} {
      allow read: if isPartyToAcceptedMatch(matchId) || isAdmin();
      allow create: if isPartyToAcceptedMatch(matchId) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.matchId == matchId &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /locations/{matchId} {
      allow read: if isPartyToAcceptedMatch(matchId) || isAdmin();
      allow write: if isPartyToAcceptedMatch(matchId) && matchData(matchId).donorId == request.auth.uid;
    }

    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /donations/{donationId} {
      allow read: if isAuthenticated() && (resource.data.donorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Health answers are never shown to the requester.
    match /screenings/{matchId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
